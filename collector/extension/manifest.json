{
  "manifest_version": 3,
  "name": "tokenmaxr Claude Web capture",
  "short_name": "tokenmaxr",
  "version": "0.1.0",
  "description": "Records estimated token usage of your claude.ai chats for tokenmaxr on this computer. Chat text is kept only if you turn on chat prompt capture in tokenmaxr (web-capture prompts).",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["estimate.js", "main-world.js"], "world": "MAIN", "run_at": "document_start", "all_frames": false },
    { "matches": ["https://claude.ai/*"], "js": ["relay.js"], "run_at": "document_start", "all_frames": false }
  ]
}
