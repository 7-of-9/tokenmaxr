{
  "name": "tokenmaxr-server",
  "version": "1.0.0",
  "private": true,
  "description": "tokenmaxr server: Azure Static Web Apps managed Functions (Node 22, Functions v4 programming model).",
  "type": "module",
  "main": "src/functions/*.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "func start",
    "test": "node --test \"test/unit/*.test.js\"",
